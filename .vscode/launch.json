{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "ARM QEMU Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/**",   
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerServerAddress": "localhost:1234",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Force GDB Dashboard to load",
                    "text": "source ~/.gdbinit",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}
